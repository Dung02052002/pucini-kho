{
  "name": "pucini-kho-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "lint": "biome check src test",
    "format": "biome format --write src test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply pucini-kho --local",
    "db:migrate:remote": "wrangler d1 migrations apply pucini-kho --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261024.1",
    "drizzle-kit": "0.31.11",
    "typescript": "5.8.2",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  }
}
