{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pucini-kho-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pucini-kho",
      "database_id": "pucini-kho-database-id"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 0 * * *",
      "0 11 * * *",
      "0 20 * * *"
    ]
  }
}
