{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pucini-kho-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pucini-kho",
      "database_id": "pucini-kho-database-id"
    }
  ],
  // Rate limit /auth/login theo IP: tối đa 10 lần / 60 giây (xem src/middleware/security/rate-limit.ts)
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 0 * * *",
      "0 11 * * *",
      "0 20 * * *"
    ]
  }
}
