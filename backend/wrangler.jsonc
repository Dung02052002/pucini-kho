{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kho-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kho-ql",
      "database_id": "your-d1-database-id"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 0 * * *",
      "0 11 * * *",
      "0 20 * * *"
    ]
  },
  // Phục vụ frontend (SPA) từ cùng Worker; request /api/* luôn đi vào Worker trước
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
